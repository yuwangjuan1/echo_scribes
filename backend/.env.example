# EchoScribe 后端配置示例：复制为 .env 后按需修改
# 转写引擎:
#   local  - 本地真实引擎（yt-dlp 下载 + faster-whisper 语音识别，无需付费 Key）
#   openai - OpenAI Whisper API（需下方 Key）
#   mock   - 内置演示引擎（假数据，零配置）
PROVIDER=local

# 服务端口
PORT=4000

# 允许的前端来源（开发环境默认放行所有来源）
CORS_ORIGIN=*

# 本地引擎 Python 解释器（需 3.10+；依赖已安装在 backend/transcriber/vendor）
PYTHON_BIN=D:\env\coda\envs\Py10\python.exe

# Whisper 模型: tiny(最快) | base | small(推荐,中文效果好) | medium(慢,更准) | large-v3(最准,需GPU)
WHISPER_MODEL=small
# cpu 或 cuda（有 NVIDIA GPU 时可用 cuda 提速 5-10 倍）
WHISPER_DEVICE=cpu
# int8(CPU 推荐) | float16(GPU 推荐)
WHISPER_COMPUTE=int8

# OpenAI Whisper 接入（PROVIDER=openai 时必填）
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# 免费试用额度（分钟）
FREE_MINUTES=10
