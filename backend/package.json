{
  "name": "echoscribe-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "EchoScribe 声稿 — 视频转文字服务端 API（链接转写 / 上传转写 / SSE 进度 / 字幕导出）",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^18.0.6",
    "express": "^4.19.2",
    "multer": "^2.0.1",
    "tsx": "^4.19.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.10.0",
    "typescript": "^5.6.3"
  }
}
